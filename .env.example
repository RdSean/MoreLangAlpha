# =============================================================================
# LangAlpha Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
#
# Quick start (Docker): set the two required keys below, then `docker compose up`
# Everything else has sensible defaults that work out of the box.
# =============================================================================

# =============================================================================
# Recommended — unlock the full experience (but not required to get started)
# =============================================================================
# LangAlpha works with zero external keys: Docker provides sandbox execution,
# and LLM access comes from your own subscription via OAuth.

# Daytona Sandbox — persistent cloud sandboxes with cross-session workspaces
# Get a key at https://www.daytona.io/
# When set, the sandbox provider auto-detects to "daytona".
# When empty, falls back to "docker" (local Docker containers).
DAYTONA_API_KEY=

# Required only for HOST_MODE=platform with Daytona. Use a deployment-unique
# namespace so staging and production never reconcile the same organization Secret.
DAYTONA_SECRET_NAMESPACE=

# Sandbox provider — auto-detected from DAYTONA_API_KEY if not set.
# Explicit values: "daytona" (hosted sandbox) or "docker" (local containers).
SANDBOX_PROVIDER=

# Docker socket exposed to the backend when SANDBOX_PROVIDER=docker.
# If your Docker context is rootless, set this to /run/user/<uid>/docker.sock.
DOCKER_HOST_SOCKET=/var/run/docker.sock

# =============================================================================
# LLM API Keys — set one, or use BYOK via OAuth (Codex, Claude)
# =============================================================================
# The default model is configured in agent_config.yaml. Set the key for
# whichever provider you want to use, or leave all empty and connect your
# existing AI subscription (ChatGPT, Claude) via OAuth in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=

# Optional deployment model profile. These values select a service-owned account
# whose encrypted BYOK credential stays in PostgreSQL; they are not API keys.
# The profile is used only after the requesting user's OAuth and BYOK miss.
PLATFORM_LLM_SOURCE_EMAIL=
PLATFORM_LLM_MODEL=

# =============================================================================
# Volcengine Doubao ASR — server-side speech recognition (optional)
# =============================================================================
# These credentials are used only by the Python WebSocket relay. Never expose
# them through VITE_ variables or commit populated values.
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_CLUSTER=
# VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v2/asr

# =============================================================================
# Web Search — at least one recommended for search tools
# =============================================================================
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# Web fetch delegation + site crawl (optional; in-house fetch needs no key)
FIRECRAWL_API_KEY=

# =============================================================================
# Optional Services
# =============================================================================

# X (Twitter) API — read-only Bearer Token for the X MCP server.
# Primary path: users store X_BEARER_TOKEN per-workspace via the UI —
#   Workspace Files panel → settings icon (top of panel) → Workspace Settings
#   → Vault tab → add secret named X_BEARER_TOKEN.
# This host-env var is a single-tenant OSS-only fallback. Setting it here is NOT enough
# on its own — you also need to uncomment the env passthrough in agent_config.yaml under
# the `x_api` MCP server. Leaving env: {} means vault is the only auth path.
# Get a token at https://console.x.com/ (App → Keys and tokens → Bearer Token).
X_BEARER_TOKEN=

# GitHub Bot (agent self-improvement — disabled by default, set github.enabled in config.yaml)
# GITHUB_BOT_TOKEN=

# LangSmith Tracing (disabled by default — set LANGSMITH_TRACING=true to enable)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langalpha

# =============================================================================
# Cloud Storage — optional S3-compatible object storage
# =============================================================================
# Provider is configured in agent_config.yaml. Family education attachments use
# a dedicated private bucket and only write keys under education/<household>/.

# --- AWS S3 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=us-east-1
# S3_PUBLIC_URL_BASE=https://d1234.cloudfront.net

# Bucket addressing: virtual (default) | path | auto.
# Most cloud S3-compatible services use virtual-hosted addressing; self-hosted /
# path-only backends (e.g. MinIO) must set this to "path". For a custom endpoint,
# give the BARE host with no bucket subdomain — embedding the bucket doubles the key.
# STORAGE_ADDRESSING_STYLE=virtual
# STORAGE_ENDPOINT_URL=https://{bare-host}

# --- MinIO education attachments ---
# Enable the `education-storage` Docker Compose profile only after setting
# unique local values below. The application storage credentials should have
# access only to the dedicated bucket; never point this configuration at an
# unrelated production bucket.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_NAME=langalpha-education
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT_URL=http://localhost:9000
# STORAGE_ADDRESSING_STYLE=path
# EDUCATION_ASSET_MAX_BYTES=10485760
# EDUCATION_ASSET_DOWNLOAD_TTL_SECONDS=300

# --- Cloudflare R2 ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL_BASE=https://cdn.yourdomain.com

# --- Alibaba Cloud OSS ---
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# =============================================================================
# Auth — first-party local accounts stored in PostgreSQL
# =============================================================================
# Deployment mode: "oss" (self-hosted) or "platform" (hosted quotas)
# HOST_MODE=oss

# Opaque HttpOnly session policy. Leave AUTH_COOKIE_SECURE false only for HTTP
# development; set it true behind an HTTPS reverse proxy.
# LOCAL_AUTH_SESSION_TTL_DAYS=14
# AUTH_COOKIE_SECURE=false

# Encryption key for API keys stored at rest (auto-generated by `make config`)
# Generate manually: openssl rand -hex 32
# BYOK_ENCRYPTION_KEY=

# Public base URL of this server (used in agent-generated URLs like preview links)
# Set to your public-facing URL in production (e.g. https://app.example.com)
# SERVER_BASE_URL=http://localhost:8000

# Shared secret authenticating internal service-to-service calls (the backend
# dispatching PTC/report-back workflows to its own /messages endpoint).
# Required when HOST_MODE=platform; in oss mode the self-dispatch is trusted
# without it. An unauthenticated background dispatch is rejected with 403,
# never run in the foreground.
# Generate manually: openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=

# External channel gateway calls the backend through this URL. Docker Compose
# sets http://backend:8000 automatically; host development uses port 8010.
# GINLIXFLOW_BASE_URL=http://127.0.0.1:8010

# =============================================================================
# Infrastructure — controls whether Docker Compose starts PostgreSQL and Redis
# =============================================================================
# Set to "infra" to start PostgreSQL and Redis in Docker (default).
# Remove or leave empty to use your own database and Redis instances.
COMPOSE_PROFILES=infra

# =============================================================================
# Database
# =============================================================================
# DB_HOST is auto-set by docker-compose.yml (defaults to "postgres" service name).
# For host development (make dev), uncomment and set to localhost:
# DB_HOST=localhost
DB_TYPE=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# TLS mode for all Postgres connections, including the checkpoint DB below.
# Default "prefer" uses TLS when the server offers it and plaintext when it
# doesn't. Set to "require" to fail loudly rather than fall back to plaintext.
# DB_SSLMODE=prefer

# =============================================================================
# Redis
# =============================================================================
# REDIS_URL is auto-set by docker-compose.yml (defaults to "redis" service name).
# For host development (make dev), uncomment and set:
# REDIS_URL=redis://:redis@localhost:6379/0
REDIS_PASSWORD=redis
# Override config.yaml redis.max_connections (default 150). Range [1, 10000].
# REDIS_MAX_CONNECTIONS=300

# Postgres connection pool overrides. Ranges [1, 500].
# POSTGRES_CHECKPOINTER_POOL_MAX=25
# POSTGRES_CONVERSATION_POOL_MAX=50

# =============================================================================
# Checkpoint DB — defaults to the same Postgres above
# =============================================================================
# Uncomment to use a separate database for LangGraph checkpoints
# MEMORY_DB_HOST=localhost
# MEMORY_DB_PORT=5432
# MEMORY_DB_NAME=langalpha
# MEMORY_DB_USER=postgres
# MEMORY_DB_PASSWORD=postgres

# OpenTelemetry (optional)
