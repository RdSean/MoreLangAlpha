# Middleware Docker Compose configuration.
# Copy to deploy/.env, set durable credentials, then run Compose from the
# repository root with: docker compose --env-file deploy/.env -f ...
#
# These variables are for PostgreSQL, Redis, and MinIO containers only. They
# do not replace the root .env used when the Python backend runs directly.

# Host ports. Bindings stay loopback-only in docker-compose-middleware.yml.
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Empty paths use the defaults relative to this Compose file:
# ./volumes/postgresql/data, ./volumes/redis, and ./volumes/minio.
# Set absolute NAS paths here when moving persistent middleware data.
POSTGRES_DATA_DIR=
REDIS_DATA_DIR=
MINIO_DATA_DIR=

# PostgreSQL. Keep these values aligned with the backend's root .env when the
# backend connects to this local middleware instance.
DB_USER=postgres
DB_PASSWORD=change-this-postgres-password
DB_NAME=postgres

# Redis. Keep REDIS_PASSWORD aligned with the backend's root .env.
REDIS_PASSWORD=change-this-redis-password

# MinIO bootstrap account and the private education attachment bucket.
MINIO_ROOT_USER=change-this-minio-user
MINIO_ROOT_PASSWORD=change-this-minio-password
STORAGE_BUCKET_NAME=langalpha-education
# The channel gateway authenticates its Flash dispatches with the same value.
# INTERNAL_SERVICE_TOKEN=
# BYOK_ENCRYPTION_KEY=
